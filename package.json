{
  "name": "soccer-news-mcp",
  "version": "2.0.0",
  "description": "MCP server for soccer news with RAG and sentiment analysis",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrations/migrate.ts",
    "seed": "tsx scripts/seed-sources.ts",
    "seed-quotes": "tsx scripts/seed-quotes.ts",
    "load-quotes": "tsx scripts/load-additional-quotes.ts",
    "test": "vitest",
    "test:feeds": "tsx scripts/test-feeds.ts",
    "rebuild-embeddings": "tsx scripts/rebuild-embeddings.ts",
    "fetch-feeds": "tsx scripts/fetch-all-feeds.ts"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.0.3",
    "@xenova/transformers": "^2.17.2",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.16.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "sharp": ">=0.35.4"
  }
}
